# Copy to `.env`, fill in, then restart with a clean cache: npx expo start -c
# Must be EXACTLY the server's BETTER_AUTH_URL — production is https://www.ninjaloop.com.au
# (WITH www: the bare domain 307-redirects to www, and a redirect drops the auth cookie).
# Local backend: http://localhost:3000 works on the iOS Simulator only; a phone needs a LAN IP / tunnel.
# LOCAL DEV ONLY — .env is never uploaded to EAS (.easignore); store builds get it from eas.json.
EXPO_PUBLIC_API_BASE_URL=https://www.ninjaloop.com.au
