# Copy to `.env`, fill in, then restart with a clean cache: npx expo start -c
# Must be the SAME URL as the Ninja Loop server's BETTER_AUTH_URL / NEXT_PUBLIC_APP_URL,
# reachable from your phone (LAN IP or a tunnel in dev — never localhost).
# LOCAL DEV ONLY — .env is never uploaded to EAS (.easignore); store builds get it from eas.json.
EXPO_PUBLIC_API_BASE_URL=https://your-ninja-loop-url.example.com
